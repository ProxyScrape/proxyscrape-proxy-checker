#!/usr/bin/env bash
# Checks version consistency before any push.
# If pushing a tag, verifies it matches package.json and enforces X-cycle rules.
# Branch-only pushes pass the version gate immediately, but still run security checks.
# Activated automatically via: git config core.hooksPath .githooks
# (set by `npm install` via the prepare script in package.json)

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
BACKEND_DIR="$ROOT/backend"

# Include ~/go/bin so gosec is found regardless of how the shell was launched.
export PATH="$PATH:$HOME/go/bin"

# ── Guest route coverage tests ───────────────────────────────────────────────
# If a new route is added to NewGuestServer without being declared in
# guestAllowed or guestBlocked (guest.go), this test fails and the push
# is blocked. Add the route to the appropriate map, then push again.

if ! command -v go &>/dev/null; then
    echo ""
    echo "ERROR: go is required for guest route coverage checks but is not installed."
    echo "  Install from: https://go.dev/dl/"
    exit 1
fi
echo "[pre-push] running guest route coverage tests..."
if ! (cd "$BACKEND_DIR" && go test ./internal/api/... -count=1 2>&1); then
    echo ""
    echo "ERROR: Guest route coverage check failed."
    echo "  Add the missing route(s) to guestAllowed or guestBlocked in:"
    echo "  backend/internal/api/guest.go"
    exit 1
fi
echo "[pre-push] ✓ Guest route coverage OK"

# ── SQL-injection safety checks (run on every push) ──────────────────────────

# 1. gosec G201/G202 — detects SQL built with fmt.Sprintf or string concatenation.
#    Scans only our own packages; vendor/ is excluded automatically by gosec.
if ! command -v gosec &>/dev/null; then
    echo ""
    echo "ERROR: gosec is required for SQL-injection checks but is not installed."
    echo "  Install with: go install github.com/securego/gosec/v2/cmd/gosec@latest"
    exit 1
fi
echo "[pre-push] running SQL-injection checks (gosec G201/G202)..."
if ! (cd "$BACKEND_DIR" && gosec -quiet -include=G201,G202 ./cmd/... ./internal/... 2>&1); then
    echo ""
    echo "ERROR: gosec found potential SQL-injection issues in backend/."
    echo "  Use parameterized queries (?) instead of fmt.Sprintf / string concat."
    exit 1
fi
echo "[pre-push] ✓ SQL-injection checks passed"

# 2. Custom rg check — detects unsafe PRAGMA statements built with %s format verbs.
#    gosec does not flag PRAGMA because it is not a DML/DQL query, but a PRAGMA
#    built with a %s verb (string interpolation) can still be exploited if the
#    value originates from user input.  Integer-only (%d) PRAGMA usage is safe and
#    intentionally excluded.  vendor/ is skipped because it is third-party code.
if ! command -v rg &>/dev/null; then
    echo ""
    echo "ERROR: rg (ripgrep) is required for PRAGMA checks but is not installed."
    echo "  Install with: brew install ripgrep  (or see https://github.com/BurntSushi/ripgrep)"
    exit 1
fi
echo "[pre-push] checking for string-interpolated PRAGMA construction..."
# Scan only our own source trees (cmd/ and internal/) — vendor/ is third-party.
PRAGMA_HITS=$(rg --with-filename --line-number -i \
    'fmt\.(Sprintf|Fprintf)\s*\([^)]*pragma[^)]*%s' \
    "$BACKEND_DIR/cmd" "$BACKEND_DIR/internal" 2>/dev/null || true)
if [ -n "$PRAGMA_HITS" ]; then
    echo ""
    echo "ERROR: Potentially unsafe dynamic PRAGMA construction detected:"
    echo "$PRAGMA_HITS"
    echo ""
    echo "  A PRAGMA built with a %s verb can be exploited if the value comes"
    echo "  from user input.  Use hard-coded strings or integer (%d) values only."
    exit 1
fi
echo "[pre-push] ✓ No unsafe PRAGMA construction found"

# ── Dead code checks ──────────────────────────────────────────────────────────
# staticcheck U1000 detects unused functions, types, constants, and variables.
# Run in -matrix mode to cover both build variants simultaneously:
#   - desktop build (no tags)        → uses capture.go, web_handler_stub.go
#   - webserver build (-tags=webserver) → uses capture_stub.go, handlers_trace.go
#
# To suppress a legitimate false positive (e.g. CGO callbacks, reflection),
# add an inline directive above the declaration in the source file:
#   //lint:ignore U1000 <reason>
# or for a whole file:
#   //lint:file-ignore U1000 <reason>

if ! command -v staticcheck &>/dev/null; then
    echo ""
    echo "ERROR: staticcheck is required for dead code checks but is not installed."
    echo "  Install with: go install honnef.co/go/tools/cmd/staticcheck@latest"
    exit 1
fi
echo "[pre-push] running dead code checks (staticcheck U1000, both build variants)..."
if ! (cd "$BACKEND_DIR" && printf 'desktop:   -tags=""\nwebserver: -tags=webserver\n' | staticcheck -checks=U1000 -matrix ./...); then
    echo ""
    echo "ERROR: staticcheck found dead code in backend/."
    echo "  Remove unused code, or suppress with:"
    echo "    //lint:ignore U1000 <reason>      (single declaration)"
    echo "    //lint:file-ignore U1000 <reason> (whole file)"
    exit 1
fi
echo "[pre-push] ✓ Dead code checks passed"

# ── Frontend dead code checks (knip) ─────────────────────────────────────────
# Detects unused JS/JSX files and exports across the renderer, main, preload,
# and shared source trees.
#
# To suppress a legitimate false positive, add to knip.json:
#   "ignore": ["src/path/to/file.js"]           (unused file)
#   "ignoreExports": { "src/path.js": ["name"] } (unused export)
# Or inline in the source file:
#   /* knip:ignore-export */
# Never skip the check at push time.

if ! command -v node &>/dev/null; then
    echo ""
    echo "ERROR: node is required for frontend dead code checks but is not installed."
    echo "  Install from: https://nodejs.org/"
    exit 1
fi
echo "[pre-push] running frontend dead code checks (knip)..."
if ! (cd "$ROOT" && npx knip --reporter compact --no-progress 2>&1); then
    echo ""
    echo "ERROR: knip found unused JS/JSX files or exports."
    echo "  Remove the dead code, or add a targeted exception in knip.json."
    exit 1
fi
echo "[pre-push] ✓ Frontend dead code checks passed"

# ── Intra-file dead code checks (oxlint) ─────────────────────────────────────
# Detects unused private variables, functions, and constants that are defined
# within a file but never called or referenced — the gap knip cannot see because
# knip only tracks exported symbols across module boundaries.
#
# Scoped to no-unused-vars only; all other default oxlint rules are suppressed
# so this check stays focused and doesn't grow into a general linter.
#
# To suppress a legitimate false positive, prefix the variable with _:
#   const _intentionallyUnused = ...;
# Or inline for a single declaration:
#   // oxlint-disable-next-line eslint/no-unused-vars
# Never skip the check at push time.

echo "[pre-push] running intra-file dead code checks (oxlint no-unused-vars)..."
if ! (cd "$ROOT" && npx oxlint -A all -D no-unused-vars src/ 2>&1); then
    echo ""
    echo "ERROR: oxlint found unused private variables or functions."
    echo "  Remove the dead code, or prefix with _ to mark as intentionally unused."
    exit 1
fi
echo "[pre-push] ✓ Intra-file dead code checks passed"

# ── Version / tag checks ──────────────────────────────────────────────────────

TAG=""
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_ref" == refs/tags/* ]]; then
        TAG="${local_ref#refs/tags/}"
    fi
done

# No tag being pushed — version gate does not apply.
if [ -z "$TAG" ]; then
    exit 0
fi

exec bash "$ROOT/scripts/check-versions.sh" "$TAG"
