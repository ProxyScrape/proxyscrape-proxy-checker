<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 JIT compilation under Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for V8's memory execution model -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required for Electron's native module dyld usage -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Required for native Node modules and bundled Go binaries -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound network access (proxy checking) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Local server for Go backend communication -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- User-selected file access (importing proxy lists) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
